{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    //"Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/Logs/ImanAcademy/ImanAcademyProd-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost; Port=5432; Database=iman_academy; Username=postgres; Password=123;"
  },
  "Jwt": {
    "Key": "a-very-long-random-secret-at-least-32-bytes-long!!",
    "Issuer": "ImanAcademy",
    "Audience": "ImanAcademyClient",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "Google": {
      "ClientId": "207025411496-61ovbg4609c3toij1d5g9pcc30b3cvkm.apps.googleusercontent.com",
      "ClientSecret": "..."
    }
  },
  "Auth": {
    "CookieSameSite": "Lax" // "Lax" if same-origin behind reverse proxy, "None" if cross-origin
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000",
    "ResetPasswordUrl": "http://localhost:3000/reset-password"
  },
  "Smtp": {
    "Host": "smtp.yourprovider.com",
    "Port": "587",
    "Username": "your-username",
    "Password": "your-password",
    "FromAddress": "no-reply@yourapp.com"
  },
  "AllowedHosts": "*"
}